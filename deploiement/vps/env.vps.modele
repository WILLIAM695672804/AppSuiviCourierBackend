# ---------------------------------------------------------------------
#  Modele. `3-installer.sh` en tire le `.env` reel, en droits 600, et y
#  place un mot de passe engendre par `openssl rand -hex 24`.
#
#  `-hex` et non `-base64` : un `/` dans le mot de passe casse l'URL de
#  connexion une fois sur deux, et la panne se lit « role ... does not
#  exist » plutot que « mot de passe ».
#
#  Ce fichier reste sur le serveur. Il n'est jamais suivi par Git.
# ---------------------------------------------------------------------

# Signe les sessions. Produite une fois, puis jamais changee : la
# modifier deconnecte tout le monde.
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=A_ENGENDRER

DEBUG=False

# Sans ce nom, Django repond 400 « Bad Request » a toutes les requetes,
# sans autre explication. Pas de point initial : un seul domaine sert.
ALLOWED_HOSTS=suivicourier.the7ing.site

# L'origine complete, schema compris. Sans elle, toute ECRITURE est
# refusee en 403 par la verification CSRF, tandis que les lectures
# continuent de fonctionner — la panne en devient deroutante : les
# ecrans s'affichent, et rien ne s'enregistre.
CSRF_TRUSTED_ORIGINS=https://suivicourier.the7ing.site

# `base` et `file` sont les noms des services de `compose.vps.yaml`, pas
# des hotes du reseau : c'est Docker qui les resout, sur le reseau
# `interne`. Jamais `localhost` — dans un conteneur, cela le designe
# lui-meme.
DATABASE_URL=postgres://suivi:A_ENGENDRER@base:5432/suivi
REDIS_URL=redis://file:6379/0

# Doit reprendre EXACTEMENT le mot de passe de `DATABASE_URL`.
# PostgreSQL le lit au premier demarrage pour creer le role ;
# l'application le lit pour s'y connecter. Une divergence ne se voit
# qu'a la connexion refusee, et le volume est deja initialise : il faut
# alors le detruire pour repartir.
POSTGRES_DB=suivi
POSTGRES_USER=suivi
POSTGRES_PASSWORD=A_ENGENDRER

# Le volume `pieces` est monte la. Ne pas y toucher : le chemin d'une
# piece est derive de son empreinte, et changer la racine perd les
# binaires deja deposes.
MEDIA_ROOT=/app/media

LIBREOFFICE_BINAIRE=soffice
LIBREOFFICE_DELAI=60
