# Copier en `.env` a la racine du repertoire de l'application (celui qui
# contient passenger_wsgi.py), et JAMAIS dans public_html.
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

DEBUG=False

# Le domaine servi, sans schema ni barre finale. Un ALLOWED_HOSTS
# incomplet fait repondre 400 a TOUTES les requetes.
ALLOWED_HOSTS=suivi.exemple.cm

# Avec le schema. Incomplet, il laisse LIRE et refuse toute ECRITURE en
# 403 — panne bien plus deroutante, parce que l'application parait marcher.
CSRF_TRUSTED_ORIGINS=https://suivi.exemple.cm

# Identifiants donnes par cPanel a la creation de la base. Le prefixe du
# compte fait partie des noms : « william_suivi », pas « suivi ».
DATABASE_URL=postgres://COMPTE_utilisateur:MOTDEPASSE@localhost:5432/COMPTE_suivi

# HORS de public_html. Un binaire servi en direct contournerait le controle
# de perimetre et la trace d'acces.
MEDIA_ROOT=/home/COMPTE/donnees-suivi/pieces

# Hors de public_html egalement : un journal lisible depuis un navigateur
# livrerait chemins, identifiants d'objets et traces d'execution.
CHEMIN_JOURNAL=/home/COMPTE/donnees-suivi/journaux/application.log

# Aucun courtier sur un mutualise. La valeur n'est pas lue tant que
# CELERY_TASK_ALWAYS_EAGER est vrai, mais django-environ la reclame.
REDIS_URL=redis://localhost:6379/0
