# Copier en .env et adapter. Le fichier .env n'est jamais versionne.
SECRET_KEY=changez-moi
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://suivi:suivi@localhost:5432/suivi
REDIS_URL=redis://localhost:6379/0
MEDIA_ROOT=./media

# Chemin du binaire LibreOffice qui convertit les documents en PDF.
LIBREOFFICE_BINAIRE=soffice
LIBREOFFICE_DELAI=60
