# ---------------------------------------------------------------------
#  Preproduction — copier en `.env.preprod`, qui n'est JAMAIS versionne.
#
#  Deux secrets ici valent un acces complet aux courriers du Port :
#  `SECRET_KEY` (qui signe les sessions) et `TUNNEL_TOKEN` (qui publie
#  l'application). Ne les faites transiter par aucune messagerie.
# ---------------------------------------------------------------------

# 50 caracteres tires au hasard. A produire une fois, puis a ne plus
# changer : la modifier deconnecte tout le monde.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

DEBUG=False

# Le nom sous lequel Cloudflare publie l'application. Sans lui, Django
# repond 400 « Bad Request » a toutes les requetes, sans autre explication.
ALLOWED_HOSTS=suivi.exemple.cm

# L'origine complete, avec le schema. Sans elle, toute ecriture est
# refusee en 403 par la verification CSRF — les lectures, elles,
# continuent de fonctionner, ce qui rend la panne deroutante.
CSRF_TRUSTED_ORIGINS=https://suivi.exemple.cm

# `base` et `file` sont les noms des services du compose, pas des hotes du
# reseau : c'est Docker qui les resout.
DATABASE_URL=postgres://suivi:CHANGEZ_MOI@base:5432/suivi
REDIS_URL=redis://file:6379/0

# Doit reprendre exactement le mot de passe ci-dessus : PostgreSQL le lit
# au premier demarrage pour creer le role, l'application le lit pour s'y
# connecter. Une divergence ne se voit qu'a la connexion refusee.
POSTGRES_DB=suivi
POSTGRES_USER=suivi
POSTGRES_PASSWORD=CHANGEZ_MOI

# Le volume `pieces` est monte la. Ne pas y toucher : le chemin d'une piece
# est derive de son empreinte, et changer la racine perd les binaires
# deja deposes.
MEDIA_ROOT=/app/media

LIBREOFFICE_BINAIRE=soffice
LIBREOFFICE_DELAI=60

# Jeton du tunnel, obtenu dans le tableau de bord Cloudflare Zero Trust
# lors de la creation du tunnel. Il porte a lui seul l'identite du tunnel.
TUNNEL_TOKEN=
